# =============================================================================
# REQUIRED
# Copy this file to terraform.tfvars and fill in your values
# =============================================================================

project_id   = "your-gcp-project-id"
github_token = "your-github-personal-access-token"

# =============================================================================
# OPTIONAL - General (defaults shown)
# =============================================================================

# region           = "us-central1"
# dataset_location = "US"
# network_name     = "data-cloud-vpc"
# subnet_cidr      = "10.0.0.0/24"
# git_repo_url     = "https://github.com/gCloud-Tech-Showcase/Data-Cloud.git"

# =============================================================================
# DEMO FLAGS
# Controls demos with ongoing costs (resources that run continuously)
#
# Demos WITHOUT flags are always enabled (pay-as-you-go, no baseline cost):
#   - Churn Prediction (BQ datasets, Vertex AI endpoint)
#   - Sentiment Analysis (BQ dataset, GCS bucket)
#   - Campaign Intelligence (BQ dataset)
#   - Security Logs (BQ dataset, GCS bucket, log sink)
#   - Video Vector Search (BQ dataset, GCS bucket)
# =============================================================================

# Vertica-to-BigQuery ingestion demo
# Creates: Vertica VM, Dataproc workflow, Cloud Scheduler, GCS buckets
# WARNING: VM incurs costs while running. See https://cloud.google.com/compute/vm-instance-pricing
# enable_vertica_demo = false

# BigQuery Graph demo for data center topology analysis (GQL queries)
# Creates: Enterprise reservation (0 baseline, autoscale)
# No ongoing costs when idle — slots only consumed during queries
# enable_bq_graph_demo   = false
# bq_graph_max_slots     = 50  # must be multiple of 50, min 50, max 500

# Spanner Graph demo for data center topology analysis
# Creates: Spanner instance (100 PU), database with property graph
# WARNING: Spanner incurs costs while running. See https://cloud.google.com/spanner/pricing
# enable_spanner_graph_demo = false

# Real-time alerting for Security Logs demo (continuous queries)
# WARNING: Creates an Enterprise reservation. See https://cloud.google.com/bigquery/pricing
# enable_realtime_alerts    = false
# realtime_alerts_max_slots = 50  # must be multiple of 50, min 50, max 500
