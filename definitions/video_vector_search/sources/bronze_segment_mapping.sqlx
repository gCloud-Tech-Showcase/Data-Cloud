config {
  type: "operations",
  schema: "video_vector_search",
  hasOutput: true,
  description: "BRONZE: Video metadata from per-video CSV files in GCS. One file per video, written by segment_videos.py during segmentation. Parallel-safe and idempotent — re-processing a video overwrites its file.",
  tags: ["video_vector_search", "bronze", "sources"],
  columns: {
    video_id: "Slug identifier for the video",
    identifier: "Archive.org item identifier",
    title: "Original video title",
    year: "Production year",
    source_url: "Archive.org source URL",
    license: "License type (Public Domain)",
    segment_index: "Zero-based segment index within the video",
    start_seconds: "Start offset of this segment in the original video",
    end_seconds: "End offset of this segment in the original video",
    duration_total_seconds: "Total duration of the original video in seconds"
  }
}

CREATE OR REPLACE EXTERNAL TABLE ${self()}
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['gs://gcloud-tech-showcase-video-search/manifests/metadata/*.csv']
)
