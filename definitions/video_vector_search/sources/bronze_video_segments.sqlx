config {
  type: "operations",
  schema: "video_vector_search",
  hasOutput: true,
  description: "BRONZE: Video segment MP4 files from GCS via BigLake Object Table. Each row represents a 2-minute video segment split from a longer source video for embedding generation.",
  tags: ["video_vector_search", "bronze", "sources"],
  columns: {
    uri: "GCS URI path to the video segment MP4 file",
    generation: "GCS object generation number for versioning",
    content_type: "MIME type of the file (video/mp4)",
    size: "File size in bytes",
    md5_hash: "MD5 hash of file contents for integrity",
    updated: "Timestamp when file was last modified in GCS",
    metadata: "Custom metadata key-value pairs from GCS object",
    ref: "ObjectRef struct with uri, version, authorizer, and details"
  }
}

CREATE OR REPLACE EXTERNAL TABLE ${self()}
WITH CONNECTION `US.vertex-ai-connection`
OPTIONS (
  object_metadata = 'SIMPLE',
  uris = ['gs://gcloud-tech-showcase-video-search/segments/*.mp4'],
  max_staleness = INTERVAL 30 MINUTE,
  metadata_cache_mode = 'AUTOMATIC'
)
