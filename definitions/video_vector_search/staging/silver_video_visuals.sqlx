config {
  type: "table",
  schema: "video_vector_search",
  description: "SILVER: AI-extracted visual metadata (Pass 1). Gemini analyzes each video to classify category, color mode, and production style. These are objective visual facts with low hallucination risk.",
  columns: {
    video_id: "Parent video identifier",
    category: "AI-detected content type: cartoon, educational, documentary, newsreel, or other",
    color_mode: "AI-detected: color or black_and_white",
    style: "AI-detected production technique: hand-drawn animation, stop motion, live action, or mixed"
  },
  tags: ["video_vector_search", "silver", "staging", "metadata"],
  dependencies: ["silver_segment_embeddings"]
}

SELECT video_id, category, color_mode, style
FROM AI.GENERATE_TABLE(
  MODEL ${ref("gemini_video_model")},
  (
    SELECT *,
      REGEXP_EXTRACT(uri, r'/segments/([^/]+)/') AS video_id,
      'Look at this video. What type of content is it (cartoon, educational, documentary, newsreel, other)? Is it in color or black_and_white? What style is it (hand-drawn animation, stop motion, live action, mixed)?' AS prompt
    FROM ${ref("bronze_video_segments")}
    WHERE uri LIKE '%/seg_000.mp4'
  ),
  STRUCT(
    'category STRING, color_mode STRING, style STRING' AS output_schema,
    0.3 AS temperature,
    512 AS max_output_tokens
  )
)
