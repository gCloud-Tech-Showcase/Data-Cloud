config {
  type: "table",
  schema: "video_vector_search",
  description: "SILVER: AI-extracted content metadata (Pass 2). Gemini analyzes each video to extract mood, description, themes, and characters. These require deeper content understanding.",
  columns: {
    video_id: "Parent video identifier",
    mood: "AI-detected mood: humorous, dramatic, educational, suspenseful, lighthearted, or serious",
    description: "AI-generated one-sentence description of the video content",
    themes: "AI-detected themes as ARRAY<STRING>",
    characters: "AI-detected character names as ARRAY<STRING> (empty if not identifiable)"
  },
  tags: ["video_vector_search", "silver", "staging", "metadata"],
  dependencies: ["silver_segment_embeddings"]
}

SELECT video_id, mood, description, themes, characters
FROM AI.GENERATE_TABLE(
  MODEL ${ref("gemini_video_model")},
  (
    SELECT *,
      REGEXP_EXTRACT(uri, r'/segments/([^/]+)/') AS video_id,
      'Describe this video clip. What is the mood (humorous, dramatic, educational, suspenseful, lighthearted, serious)? Write one sentence describing the main action. List 2-4 themes. List character names only if you can identify them, otherwise leave empty.' AS prompt
    FROM ${ref("bronze_video_segments")}
    WHERE uri LIKE '%/seg_000.mp4'
  ),
  STRUCT(
    'mood STRING, description STRING, themes ARRAY<STRING>, characters ARRAY<STRING>' AS output_schema,
    0.3 AS temperature,
    1024 AS max_output_tokens
  )
)
