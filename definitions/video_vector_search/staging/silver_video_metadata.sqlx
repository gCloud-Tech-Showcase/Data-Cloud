config {
  type: "table",
  schema: "video_vector_search",
  description: "SILVER: Combined AI-extracted video metadata from two-pass Gemini analysis. Pass 1 extracts visual facts (category, color, style). Pass 2 extracts content analysis (mood, description, themes, characters). Split into two passes for better accuracy — fewer fields per prompt reduces hallucination.",
  columns: {
    video_id: "Parent video identifier",
    category: "AI-detected content type",
    color_mode: "AI-detected color mode",
    style: "AI-detected production style",
    mood: "AI-detected mood",
    description: "AI-generated one-sentence description",
    themes: "AI-detected themes",
    characters: "AI-detected character names"
  },
  tags: ["video_vector_search", "silver", "staging", "metadata"]
}

SELECT
  COALESCE(v.video_id, c.video_id) AS video_id,
  v.category,
  v.color_mode,
  v.style,
  c.mood,
  c.description,
  c.themes,
  c.characters
FROM ${ref("silver_video_visuals")} v
FULL OUTER JOIN ${ref("silver_video_content")} c
  ON v.video_id = c.video_id
