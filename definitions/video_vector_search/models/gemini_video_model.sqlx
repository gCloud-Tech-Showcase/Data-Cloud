config {
  type: "operations",
  schema: "video_vector_search",
  hasOutput: true,
  description: "Remote Gemini 2.5 Flash model for multimodal video analysis. Used to extract structured metadata (category, themes, characters, mood, etc.) from video content via AI.GENERATE with OBJ.GET_ACCESS_URL.",
  tags: ["video_vector_search", "models"]
}

CREATE OR REPLACE MODEL ${self()}
REMOTE WITH CONNECTION `US.vertex-ai-connection`
OPTIONS (
  ENDPOINT = 'gemini-2.5-flash'
)
