config {
  type: "operations",
  schema: "video_vector_search",
  hasOutput: true,
  description: "Remote Gemini model for multimodal video analysis. Used to extract structured metadata (category, themes, characters, mood, etc.) from video content.",
  tags: ["video_vector_search", "models"]
}

CREATE OR REPLACE MODEL ${self()}
REMOTE WITH CONNECTION `US.vertex-ai-connection`
OPTIONS (
  ENDPOINT = 'gemini-2.0-flash-001'
)
