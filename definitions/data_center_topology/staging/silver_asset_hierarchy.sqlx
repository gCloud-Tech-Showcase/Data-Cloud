config {
  type: "view",
  schema: "data_center_topology",
  description: "SILVER: Flattened asset view with location hierarchy. Denormalizes the location path from region to room for each hardware asset.",
  tags: ["data_center_topology", "silver", "staging"]
}

-- Flattened view of hardware assets with full location hierarchy
-- Useful for queries that need location context without traversing the hierarchy
SELECT
  -- Asset details
  ha.asset_id,
  ha.asset_type,
  ha.hostname,
  ha.model,
  ha.manufacturer,
  ha.criticality_tier AS asset_criticality,
  ha.status AS asset_status,
  ha.cpu_cores,
  ha.ram_gb,
  ha.storage_tb,
  ha.warranty_expiry,

  -- Rack details
  r.rack_id,
  r.rack_name,
  r.power_capacity_kw,
  r.cooling_zone,
  r.status AS rack_status,
  ha.rack_position_start,
  ha.rack_position_end,

  -- Row (immediate location of rack)
  row_loc.location_id AS row_id,
  row_loc.name AS row_name,

  -- Data Center
  dc.location_id AS data_center_id,
  dc.name AS data_center_name,

  -- Region
  region.location_id AS region_id,
  region.name AS region_name,
  region.geo_latitude,
  region.geo_longitude,

  -- Timestamps
  ha.created_at,
  ha.updated_at

FROM ${ref("hardware_assets")} ha
JOIN ${ref("racks")} r ON ha.rack_id = r.rack_id
JOIN ${ref("locations")} row_loc ON r.location_id = row_loc.location_id AND row_loc.location_type = 'row'
JOIN ${ref("locations")} dc ON row_loc.parent_location_id = dc.location_id AND dc.location_type = 'data_center'
JOIN ${ref("locations")} region ON dc.parent_location_id = region.location_id AND region.location_type = 'region'

WHERE ha.status != 'decommissioned'
