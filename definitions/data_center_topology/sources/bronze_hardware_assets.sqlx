config {
  type: "declaration",
  schema: "data_center_topology",
  name: "hardware_assets",
  description: "BRONZE: Physical hardware assets (servers, network switches, storage arrays) installed in racks. Core nodes for infrastructure impact analysis.",
  columns: {
    asset_id: "Unique identifier for the hardware asset (UUID)",
    asset_type: "Type of hardware: SERVER, SWITCH, STORAGE, or PDU",
    rack_id: "Reference to the rack containing this asset",
    rack_position: "Position within the rack (U number, 1-42)",
    hostname: "Network hostname of the device",
    model: "Hardware model identifier",
    manufacturer: "Hardware manufacturer name",
    serial_number: "Manufacturer serial number",
    cpu_cores: "Number of CPU cores (for servers)",
    ram_gb: "RAM capacity in gigabytes (for servers)",
    storage_tb: "Storage capacity in terabytes",
    warranty_expiry: "Date when warranty expires",
    criticality_tier: "Business criticality: TIER_1 (critical), TIER_2 (important), TIER_3 (standard)",
    status: "Operational status: ACTIVE, MAINTENANCE, FAILED, or DECOMMISSIONED",
    created_at: "Timestamp when the asset record was created",
    updated_at: "Timestamp when the asset record was last updated"
  }
}
