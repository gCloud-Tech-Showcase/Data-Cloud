config {
  type: "view",
  schema: "security_logs",
  description: "SILVER: Flattened and cleansed Cloud Audit Log events for analysis. Extracts key fields from nested protopayload_auditlog structure.",
  columns: {
    event_id: "Unique identifier for the audit event",
    event_timestamp: "When the event occurred",
    received_timestamp: "When Cloud Logging received the event",
    log_type: "Type of audit log (activity, data_access, system_event)",
    severity: "Log severity level",
    principal_email: "User or service account that performed the action",
    caller_ip: "IP address of the caller",
    caller_user_agent: "User agent string of the caller",
    service_name: "GCP service that was called (e.g., bigquery.googleapis.com)",
    method_name: "API method that was called",
    resource_name: "Full resource name that was accessed or modified",
    resource_type: "Type of resource from the monitored resource",
    status_code: "gRPC status code (0 = success)",
    status_message: "Error message if the operation failed",
    request_summary: "Summarized request details for AI analysis"
  },
  tags: ["security_logs", "silver", "staging"]
}

SELECT
  insertId AS event_id,
  timestamp AS event_timestamp,
  receiveTimestamp AS received_timestamp,
  'activity' AS log_type,
  severity,

  -- Authentication details
  protopayload_auditlog.authenticationInfo.principalEmail AS principal_email,
  protopayload_auditlog.requestMetadata.callerIp AS caller_ip,
  protopayload_auditlog.requestMetadata.callerSuppliedUserAgent AS caller_user_agent,

  -- Action details
  protopayload_auditlog.serviceName AS service_name,
  protopayload_auditlog.methodName AS method_name,
  protopayload_auditlog.resourceName AS resource_name,
  resource.type AS resource_type,

  -- Status
  COALESCE(protopayload_auditlog.status.code, 0) AS status_code,
  protopayload_auditlog.status.message AS status_message,

  -- Create a summary for AI analysis
  CONCAT(
    'User: ', COALESCE(protopayload_auditlog.authenticationInfo.principalEmail, 'unknown'),
    ' | Action: ', COALESCE(protopayload_auditlog.methodName, 'unknown'),
    ' | Service: ', COALESCE(protopayload_auditlog.serviceName, 'unknown'),
    ' | Resource: ', COALESCE(protopayload_auditlog.resourceName, 'unknown'),
    ' | Status: ', CAST(COALESCE(protopayload_auditlog.status.code, 0) AS STRING),
    CASE WHEN protopayload_auditlog.status.message IS NOT NULL
         THEN CONCAT(' (', protopayload_auditlog.status.message, ')')
         ELSE '' END,
    ' | IP: ', COALESCE(protopayload_auditlog.requestMetadata.callerIp, 'unknown')
  ) AS request_summary

FROM ${ref("cloudaudit_googleapis_com_activity")}
WHERE timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)
