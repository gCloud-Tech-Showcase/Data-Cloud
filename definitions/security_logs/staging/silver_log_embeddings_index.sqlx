config {
  type: "operations",
  schema: "security_logs",
  hasOutput: false,
  description: "Vector index on log embeddings for fast approximate nearest neighbor search",
  tags: ["security_logs", "silver", "staging", "embeddings", "index"],
  dependencies: ["silver_log_embeddings"]
}

-- Create a vector index for fast similarity search
-- TREE_AH is optimized for high-dimensional vectors
CREATE OR REPLACE VECTOR INDEX log_embeddings_idx
ON ${ref("silver_log_embeddings")}(embedding)
OPTIONS (
  index_type = 'IVF',
  distance_type = 'COSINE',
  ivf_options = '{"num_lists": 100}'
)
