config {
  type: "operations",
  schema: "security_logs",
  hasOutput: true,
  description: "SILVER: Audit log events with autonomous embedding generation. Embeddings are auto-generated on insert using AI.EMBED.",
  tags: ["security_logs", "silver", "staging", "embeddings"]
}

-- Create table with autonomous embedding generation
-- Embeddings are automatically generated when rows are inserted
CREATE OR REPLACE TABLE ${self()} (
  event_id STRING,
  event_timestamp TIMESTAMP,
  principal_email STRING,
  service_name STRING,
  method_name STRING,
  status_code INT64,
  event_summary STRING,
  -- Autonomous embedding generation: BigQuery auto-generates on insert
  embedding ARRAY<FLOAT64>
    GENERATED ALWAYS AS (AI.EMBED(
      event_summary,
      connection_id => 'us.vertex-ai-connection',
      endpoint => 'text-embedding-005'
    ).result) STORED OPTIONS (asynchronous = TRUE)
);

-- Populate the table from silver_audit_events
INSERT INTO ${self()} (
  event_id,
  event_timestamp,
  principal_email,
  service_name,
  method_name,
  status_code,
  event_summary
)
SELECT
  event_id,
  event_timestamp,
  principal_email,
  service_name,
  method_name,
  status_code,
  CONCAT(
    'A ',
    CASE WHEN status_code = 0 THEN 'successful' ELSE 'failed' END,
    ' ',
    COALESCE(method_name, 'unknown action'),
    ' operation on ',
    COALESCE(service_name, 'unknown service'),
    ' by ',
    COALESCE(principal_email, 'unknown user'),
    '.'
  ) AS event_summary
FROM ${ref("silver_audit_events")}
WHERE event_timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)
LIMIT 1000;
